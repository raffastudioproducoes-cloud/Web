# ============================================================================
# VARIÁVEIS DE AMBIENTE - MINHAROTA RENDER DEPLOYMENT
# ============================================================================
# 
# INSTRUÇÕES:
# 1. Copie todos os valores abaixo
# 2. No Render, vá para: Web Service → Environment Variables
# 3. Cole cada linha (KEY=VALUE)
# 4. Substitua os valores <entre_colchetes> pelos valores reais
# 5. Clique em "Save"
#
# ============================================================================

# AMBIENTE
NODE_ENV=production

# BANCO DE DADOS (Obrigatório)
# Formato: mysql://usuario:senha@host:porta/banco_dados
DATABASE_URL=<seu_database_url_aqui>

# AUTENTICAÇÃO (Obrigatório)
JWT_SECRET=<sua_chave_secreta_jwt_aqui>

# MANUS OAUTH (Obrigatório)
VITE_APP_ID=<seu_vite_app_id_aqui>
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=<seu_vite_oauth_portal_url_aqui>

# PROPRIETÁRIO (Obrigatório)
OWNER_OPEN_ID=<seu_owner_open_id_aqui>
OWNER_NAME=<seu_nome_aqui>

# FORGE API - BACKEND (Obrigatório)
BUILT_IN_FORGE_API_URL=<seu_built_in_forge_api_url_aqui>
BUILT_IN_FORGE_API_KEY=<sua_built_in_forge_api_key_aqui>

# FORGE API - FRONTEND (Obrigatório)
VITE_FRONTEND_FORGE_API_URL=<seu_vite_frontend_forge_api_url_aqui>
VITE_FRONTEND_FORGE_API_KEY=<sua_vite_frontend_forge_api_key_aqui>

# ANALYTICS (Opcional)
VITE_ANALYTICS_ENDPOINT=<seu_vite_analytics_endpoint_aqui>
VITE_ANALYTICS_WEBSITE_ID=<seu_vite_analytics_website_id_aqui>

# ============================================================================
# NOTAS IMPORTANTES:
# ============================================================================
#
# 1. DATABASE_URL:
#    - Formato: mysql://user:password@hostname:3306/database
#    - Exemplo: mysql://root:pass123@db.example.com:3306/minharota
#    - Obrigatório para funcionar
#
# 2. JWT_SECRET:
#    - Deve ser uma string forte e aleatória
#    - Exemplo: sk-proj-abc123xyz789def456ghi789jkl012mno345pqr
#    - Mínimo 32 caracteres
#
# 3. VITE_APP_ID:
#    - Obtém no painel Manus → Settings → App ID
#    - Formato: geralmente um UUID
#
# 4. OWNER_OPEN_ID:
#    - Seu ID único no Manus
#    - Obtém em: Manus → Account → Open ID
#
# 5. BUILT_IN_FORGE_API_KEY:
#    - Chave de API do Manus para backend
#    - Obtém em: Manus → Settings → API Keys
#
# 6. VITE_FRONTEND_FORGE_API_KEY:
#    - Chave de API do Manus para frontend
#    - Obtém em: Manus → Settings → API Keys (Frontend)
#
# 7. Variáveis Analytics são OPCIONAIS
#    - Se não tiver, deixe em branco ou remova
#
# ============================================================================
